 &control
    calculation     = 'scf'
    prefix          = 'sc'
    pseudo_dir      = '/home/koussay/blockc/pseudo'
    outdir          = './tmp'
    tprnfor         = .true.
    disk_io         = 'none'
/
 &system
    ibrav           = 0
